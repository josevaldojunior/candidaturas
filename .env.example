# Copie para .env e ajuste (o .env não vai para o git).

# Obrigatório: segredo que assina os logins (JWT). Use um valor aleatório e longo, por exemplo:
#   openssl rand -base64 48
JWT_SEGREDO=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# Senha do PostgreSQL
DB_PASSWORD=candidaturas

# true: qualquer pessoa pode criar conta. false: só a primeira conta (uso pessoal).
CADASTRO_ABERTO=true

# Duração do login, em horas
SESSAO_HORAS=12

# Endereço(s) do frontend, separados por vírgula (ex.: https://candidaturas.seudominio.com)
CORS_ORIGENS=http://localhost:4200

# E-mail da conta que recebe os CSVs da pasta ./inbox (vazio desliga a leitura automática)
INBOX_USUARIO=

# Portas publicadas no computador/servidor
API_PORTA=8080
WEB_PORTA=4200
